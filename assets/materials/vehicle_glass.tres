[gd_resource type="StandardMaterial3D" format=3]

; Autoglas (seit Etappe 6d): deutlich abgedunkelt – Sitze, Lenkrad und die Person am Steuer sieht man
; nur schemenhaft. Dunkler/heller: Alpha von Albedo Color (1 = gar nicht durchsichtig).

[resource]
resource_name = "glass_car"
transparency = 1
cull_mode = 2
albedo_color = Color(0.07, 0.085, 0.1, 0.8)
metallic = 0.2
metallic_specular = 0.7
roughness = 0.12
