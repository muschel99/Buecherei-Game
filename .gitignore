# Von Godot automatisch erzeugte Dateien (werden auf jedem PC neu angelegt)
.godot/

# Testbilder von tools/screenshots.sh (nur zur Kontrolle, nicht ins Projekt)
screenshots/

# Zwischenspeicher von Python (tools/plan_check.py)
__pycache__/

# Sicherungskopien von Blender
*.blend1

# Texturen, die Godot beim Import aus den Figuren (.glb) herauslöst (entstehen auf jedem PC neu)
assets/models/characters/*.jpg
assets/models/characters/*.jpg.import
assets/models/characters/*.png
assets/models/characters/*.png.import
assets/models/characters/chibi/*.png
assets/models/characters/chibi/*.png.import
