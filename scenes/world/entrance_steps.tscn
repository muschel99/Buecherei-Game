[gd_scene load_steps=3 format=3]

; Podest mit Stufen vor der Ladentür (Etappe 4d), gebaut von scripts/world/entrance_steps.gd.
; Ursprung außen auf der Hauswand in der Türmitte, auf Höhe des Ladenbodens; +Z nach draußen.
; Maße in GameConfig (entrance_…, shop_floor_rise). Eigenes Modell: Kind-Knoten "Model".
; Seit „Modelle schöner“: alte Sandsteinstufen aus tools/blender/build_storybook_steps.py (Model); das Script baut dann
; keine Platzhalter-Stufen mehr, nur die unsichtbare Rampe (Kollision) und die Hindernis-Kreise für Passanten.

[ext_resource type="Script" path="res://scripts/world/entrance_steps.gd" id="1_steps"]
[ext_resource type="PackedScene" path="res://assets/models/facade/entrance_steps.glb" id="2_model"]

[node name="EntranceSteps" type="Node3D"]
script = ExtResource("1_steps")

[node name="Model" parent="." instance=ExtResource("2_model")]
