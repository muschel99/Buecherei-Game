[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/pause_menu.gd" id="1_pause"]
[ext_resource type="PackedScene" path="res://scenes/ui/settings_panel.tscn" id="2_settings"]

[node name="PauseMenu" type="CanvasLayer"]
process_mode = 3
layer = 10
script = ExtResource("1_pause")

[node name="Dimmer" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.08, 0.05, 0.03, 0.55)

[node name="MainPanel" type="PanelContainer" parent="."]
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
grow_horizontal = 2
grow_vertical = 2

[node name="VBox" type="VBoxContainer" parent="MainPanel"]
custom_minimum_size = Vector2(280, 0)
theme_override_constants/separation = 14

[node name="Title" type="Label" parent="MainPanel/VBox"]
theme_override_font_sizes/font_size = 32
text = "Pause"
horizontal_alignment = 1

[node name="Spacer" type="Control" parent="MainPanel/VBox"]
custom_minimum_size = Vector2(0, 6)

[node name="ResumeButton" type="Button" parent="MainPanel/VBox"]
unique_name_in_owner = true
text = "Weiter"

[node name="ControlsButton" type="Button" parent="MainPanel/VBox"]
text = "Steuerung"

[node name="SettingsButton" type="Button" parent="MainPanel/VBox"]
text = "Einstellungen"

[node name="QuitButton" type="Button" parent="MainPanel/VBox"]
text = "Beenden"

[node name="ControlsPanel" type="PanelContainer" parent="."]
visible = false
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
grow_horizontal = 2
grow_vertical = 2

[node name="VBox" type="VBoxContainer" parent="ControlsPanel"]
custom_minimum_size = Vector2(420, 0)
theme_override_constants/separation = 18

[node name="Title" type="Label" parent="ControlsPanel/VBox"]
theme_override_font_sizes/font_size = 32
text = "Steuerung"
horizontal_alignment = 1

[node name="KeyGrid" type="GridContainer" parent="ControlsPanel/VBox"]
theme_override_constants/h_separation = 40
theme_override_constants/v_separation = 5
columns = 2

[node name="Key1" type="Label" parent="ControlsPanel/VBox/KeyGrid"]
theme_override_colors/font_color = Color(0.96, 0.78, 0.48, 1)
text = "W  A  S  D"

[node name="Action1" type="Label" parent="ControlsPanel/VBox/KeyGrid"]
text = "Laufen"

[node name="KeySprint" type="Label" parent="ControlsPanel/VBox/KeyGrid"]
theme_override_colors/font_color = Color(0.96, 0.78, 0.48, 1)
text = "Umschalt"

[node name="ActionSprint" type="Label" parent="ControlsPanel/VBox/KeyGrid"]
text = "Schneller laufen (gedrückt halten)"

[node name="KeyJump" type="Label" parent="ControlsPanel/VBox/KeyGrid"]
theme_override_colors/font_color = Color(0.96, 0.78, 0.48, 1)
text = "Leertaste"

[node name="ActionJump" type="Label" parent="ControlsPanel/VBox/KeyGrid"]
text = "Springen (im Sitzen: aufstehen)"

[node name="KeyCrouch" type="Label" parent="ControlsPanel/VBox/KeyGrid"]
theme_override_colors/font_color = Color(0.96, 0.78, 0.48, 1)
text = "Strg (halten)"

[node name="ActionCrouch" type="Label" parent="ControlsPanel/VBox/KeyGrid"]
text = "Hocken"

[node name="Key2" type="Label" parent="ControlsPanel/VBox/KeyGrid"]
theme_override_colors/font_color = Color(0.96, 0.78, 0.48, 1)
text = "Maus"

[node name="Action2" type="Label" parent="ControlsPanel/VBox/KeyGrid"]
text = "Umsehen"

[node name="Key3" type="Label" parent="ControlsPanel/VBox/KeyGrid"]
theme_override_colors/font_color = Color(0.96, 0.78, 0.48, 1)
text = "E"

[node name="Action3" type="Label" parent="ControlsPanel/VBox/KeyGrid"]
text = "Benutzen: Lampen, Tür, Sitzen, Kartons, Tablet (Apps)"

[node name="KeyTake" type="Label" parent="ControlsPanel/VBox/KeyGrid"]
theme_override_colors/font_color = Color(0.96, 0.78, 0.48, 1)
text = "Rechtsklick"

[node name="ActionTake" type="Label" parent="ControlsPanel/VBox/KeyGrid"]
text = "Buch nehmen (Regal, Tisch, Rückgabekasten …) – bis zu 7 tragen"

[node name="KeyPlace" type="Label" parent="ControlsPanel/VBox/KeyGrid"]
theme_override_colors/font_color = Color(0.96, 0.78, 0.48, 1)
text = "Linksklick"

[node name="ActionPlace" type="Label" parent="ControlsPanel/VBox/KeyGrid"]
text = "Buch obenauf genau dort ablegen, wo du hinschaust"

[node name="KeyHold" type="Label" parent="ControlsPanel/VBox/KeyGrid"]
theme_override_colors/font_color = Color(0.96, 0.78, 0.48, 1)
text = "Linksklick halten am Regal"

[node name="ActionHold" type="Label" parent="ControlsPanel/VBox/KeyGrid"]
text = "Alle passenden Bücher einräumen – ab dem Fach und der Stelle, auf die du schaust"

[node name="KeyShelf" type="Label" parent="ControlsPanel/VBox/KeyGrid"]
theme_override_colors/font_color = Color(0.96, 0.78, 0.48, 1)
text = "R am Regal"

[node name="ActionShelf" type="Label" parent="ControlsPanel/VBox/KeyGrid"]
text = "Regal-Menü: Genre je Fach, Buch aus dem Lager, auffüllen, sortieren"

[node name="KeyWheel" type="Label" parent="ControlsPanel/VBox/KeyGrid"]
theme_override_colors/font_color = Color(0.96, 0.78, 0.48, 1)
text = "Mausrad"

[node name="ActionWheel" type="Label" parent="ControlsPanel/VBox/KeyGrid"]
text = "Beim Tragen: Buch vor dem Ablegen drehen (flach oder angelehnt)"

[node name="KeyCycle" type="Label" parent="ControlsPanel/VBox/KeyGrid"]
theme_override_colors/font_color = Color(0.96, 0.78, 0.48, 1)
text = "E beim Tragen"

[node name="ActionCycle" type="Label" parent="ControlsPanel/VBox/KeyGrid"]
text = "Anderes Buch obenauf (Umschalt + E: zurück), wenn das Angeschaute nichts mit E macht"

[node name="KeyStore" type="Label" parent="ControlsPanel/VBox/KeyGrid"]
theme_override_colors/font_color = Color(0.96, 0.78, 0.48, 1)
text = "Q halten"

[node name="ActionStore" type="Label" parent="ControlsPanel/VBox/KeyGrid"]
text = "Alle getragenen Bücher ins Lager legen"

[node name="KeyReturnBox" type="Label" parent="ControlsPanel/VBox/KeyGrid"]
theme_override_colors/font_color = Color(0.96, 0.78, 0.48, 1)
text = "E am Rückgabekasten"

[node name="ActionReturnBox" type="Label" parent="ControlsPanel/VBox/KeyGrid"]
text = "So viele Bücher nehmen, wie in die Hände passen"

[node name="KeyBuild" type="Label" parent="ControlsPanel/VBox/KeyGrid"]
theme_override_colors/font_color = Color(0.96, 0.78, 0.48, 1)
text = "Tab"

[node name="ActionBuild" type="Label" parent="ControlsPanel/VBox/KeyGrid"]
text = "Gestaltungsmodus (Inventar) öffnen/schließen"

[node name="KeyRemove" type="Label" parent="ControlsPanel/VBox/KeyGrid"]
theme_override_colors/font_color = Color(0.96, 0.78, 0.48, 1)
text = "X"

[node name="ActionRemove" type="Label" parent="ControlsPanel/VBox/KeyGrid"]
text = "Im Gestaltungsmodus: Objekt ins Inventar legen"

[node name="KeyFps" type="Label" parent="ControlsPanel/VBox/KeyGrid"]
theme_override_colors/font_color = Color(0.96, 0.78, 0.48, 1)
text = "F3"

[node name="ActionFps" type="Label" parent="ControlsPanel/VBox/KeyGrid"]
text = "Bilder pro Sekunde anzeigen"

[node name="KeyTestBooks" type="Label" parent="ControlsPanel/VBox/KeyGrid"]
theme_override_colors/font_color = Color(0.96, 0.78, 0.48, 1)
text = "F9"

[node name="ActionTestBooks" type="Label" parent="ControlsPanel/VBox/KeyGrid"]
text = "Test: Bücher in den Rückgabekasten legen"

[node name="KeyTestMoney" type="Label" parent="ControlsPanel/VBox/KeyGrid"]
theme_override_colors/font_color = Color(0.96, 0.78, 0.48, 1)
text = "F10"

[node name="ActionTestMoney" type="Label" parent="ControlsPanel/VBox/KeyGrid"]
text = "Test: 500 Taler dazu"

[node name="Key4" type="Label" parent="ControlsPanel/VBox/KeyGrid"]
theme_override_colors/font_color = Color(0.96, 0.78, 0.48, 1)
text = "Esc"

[node name="Action4" type="Label" parent="ControlsPanel/VBox/KeyGrid"]
text = "Schließt, was offen ist – sonst Pausenmenü"

[node name="BackButton" type="Button" parent="ControlsPanel/VBox"]
unique_name_in_owner = true
text = "Zurück"

[node name="SettingsPanel" parent="." instance=ExtResource("2_settings")]
visible = false

[connection signal="pressed" from="MainPanel/VBox/ResumeButton" to="." method="_on_resume_button_pressed"]
[connection signal="pressed" from="MainPanel/VBox/ControlsButton" to="." method="_on_controls_button_pressed"]
[connection signal="pressed" from="MainPanel/VBox/SettingsButton" to="." method="_on_settings_button_pressed"]
[connection signal="back_requested" from="SettingsPanel" to="." method="_on_back_button_pressed"]
[connection signal="pressed" from="MainPanel/VBox/QuitButton" to="." method="_on_quit_button_pressed"]
[connection signal="pressed" from="ControlsPanel/VBox/BackButton" to="." method="_on_back_button_pressed"]
