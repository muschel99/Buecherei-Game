[gd_scene load_steps=8 format=3]

; Bild hinter dem Hauptmenü (TitleBackdrop): Rasen-Insel mit Rundbank und dem großen Gartenbaum vor einem weichen
; Abendhimmel. Austauschbar: "Garden" (assets/models/title/title_garden.glb) und "Tree" durch eigene Modelle ersetzen,
; Farben des Himmels im Material unten, Blumen in scripts/ui/title_backdrop.gd (PLANTS), Kamera in GameConfig.title_camera_*.

